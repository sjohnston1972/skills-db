# Copy to .env for local development (npm start outside Docker).
# The Docker image does NOT include .env — the Dockerfile ENV block supplies
# these same defaults at runtime. Never commit a real .env.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skills_matrix
DB_USER=skillsuser
DB_PASSWORD=changeme123

# Server
PORT=3000
NODE_ENV=production

# Optional: enables the AI insights/chat endpoints without storing a key in
# the Settings UI. Get a key at https://console.anthropic.com/
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=

# Optional: where verifyAdminAuth reads basic-auth users from
# (defaults to /etc/nginx/.htpasswd inside the container).
#HTPASSWD_FILE=
